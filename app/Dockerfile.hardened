# Atlas Distribution - Hardened Web Tier Production Baseline
# DevSecOps Remediation Phase
FROM php:8.2-apache-bullseye

# Install only minimal runtime dependencies (NO SSH DAEMON IN WEB CONTAINER)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && docker-php-ext-install pdo pdo_pgsql \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Enable Apache security headers
RUN a2enmod headers rewrite

# Remove default boilerplate files
RUN rm -rf /var/www/html/*

# Deploy hardened Apache vhost
COPY config/hardened-vhost.conf /etc/apache2/sites-available/000-default.conf

# Deploy application code
COPY src/index.php /var/www/html/
COPY src/upload.php /var/www/html/
COPY src/db.php /var/www/html/

# Create uploads directory with restricted non-executable rights
RUN mkdir -p /var/www/html/uploads && \
    chown -R www-data:www-data /var/www/html && \
    chmod 750 /var/www/html && \
    chmod 770 /var/www/html/uploads

# Hide Apache version signatures
RUN echo "ServerTokens Prod" >> /etc/apache2/apache2.conf && \
    echo "ServerSignature Off" >> /etc/apache2/apache2.conf

EXPOSE 80

USER www-data

CMD ["apache2-foreground"]
